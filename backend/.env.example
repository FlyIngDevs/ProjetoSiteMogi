# Database
DATABASE_URL=sqlite:///./shopping.db
# DATABASE_URL=postgresql://user:password@localhost/shopping_db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server
DEBUG=True
API_TITLE=Shopping Platform API
API_VERSION=1.0.0

# SMTP / job applications
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USERNAME=seu-usuario
SMTP_PASSWORD=sua-senha
SMTP_FROM_EMAIL=no-reply@seudominio.com
SMTP_FROM_NAME=ShoppingHub
SMTP_USE_TLS=true
SMTP_USE_SSL=false
JOB_APPLICATION_MAX_RESUME_SIZE_MB=5
